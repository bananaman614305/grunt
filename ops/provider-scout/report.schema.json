{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "web_search_used": {
      "type": "boolean"
    },
    "search_queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "homepage": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "context_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "free_access": {
            "type": "string",
            "enum": [
              "recurring",
              "one_time",
              "unclear"
            ]
          },
          "quality": {
            "type": "string",
            "enum": [
              "target",
              "above_baseline",
              "below_baseline",
              "unclear"
            ]
          },
          "signup_friction": {
            "type": "string",
            "enum": [
              "low",
              "human_approval",
              "high",
              "unclear"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "researched",
              "rejected",
              "needs_approval",
              "setup_blocked",
              "integration_pending",
              "ready_for_review"
            ]
          },
          "reason": {
            "type": "string"
          },
          "primary_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_policy": {
            "type": "string"
          },
          "setup_status": {
            "type": "string",
            "enum": [
              "not_attempted",
              "reused",
              "signed_up",
              "anonymous",
              "blocked",
              "approval_needed"
            ]
          },
          "qualification_blocker": {
            "type": ["string", "null"],
            "enum": [null, "human_verification_required", "oauth_confirmation_required", "operator_approval_required"]
          },
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "http_status": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reply_received": {
                "type": "boolean"
              },
              "attribution_verified": {
                "type": "boolean"
              },
              "tool_call_verified": {
                "type": "boolean"
              },
              "free_guard_verified": {
                "type": "boolean"
              },
              "evidence_file": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "http_status",
              "source_id",
              "reply_received",
              "attribution_verified",
              "tool_call_verified",
              "free_guard_verified",
              "evidence_file"
            ]
          },
          "proposal_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "release_request": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "checkout": {
                "type": "string",
                "minLength": 1
              },
              "head_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "base_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "source_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "evidence_file": {
                "type": "string",
                "minLength": 1
              },
              "pr_number": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "config_dir": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "checkout",
              "head_sha",
              "base_sha",
              "source_id",
              "model",
              "evidence_file",
              "pr_number",
              "config_dir"
            ]
          }
        },
        "required": [
          "provider",
          "homepage",
          "model",
          "context_tokens",
          "free_access",
          "quality",
          "signup_friction",
          "status",
          "reason",
          "primary_sources",
          "data_policy",
          "setup_status",
          "probe",
          "proposal_url",
          "release_request"
        ]
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "summary",
    "web_search_used",
    "search_queries",
    "candidates",
    "blockers"
  ]
}
