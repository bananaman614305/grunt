{
  "name": "milo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint . && tsc -b",
    "typecheck": "tsc -b",
    "eval": "pnpm --filter @milo/evals run eval",
    "bench": "pnpm --filter @milo/evals run bench"
  },
  "devDependencies": {
    "@types/node": "22",
    "eslint": "9",
    "typescript": "5",
    "typescript-eslint": "8",
    "vitest": "3"
  }
}
