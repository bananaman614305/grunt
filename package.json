{
  "name": "usegrunt",
  "version": "0.10.19",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3@12.11.1"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "benchmark:efficiency": "tsx src/local/efficiency-benchmark.ts",
    "benchmark:workload": "tsx src/local/workload-benchmark.ts",
    "benchmark:metadata": "tsx scripts/metadata-benchmark.ts",
    "lint": "eslint src && tsc --noEmit",
    "local": "tsx src/local/main.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@hono/node-server": "^1.19.17",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@trusty-squire/mcp": "^1.2.0",
    "ajv": "^8.20.0",
    "chalk": "^6.0.1",
    "hono": "^4.13.8",
    "ipaddr.js": "^2.5.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  },
  "bin": {
    "usegrunt": "dist/local/main.js",
    "grunt-local": "dist/local/main.js"
  },
  "description": "One-command setup for grunt",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bananaman614305/grunt.git"
  },
  "homepage": "https://grunt.run",
  "bugs": {
    "url": "https://github.com/bananaman614305/grunt/issues"
  }
}
