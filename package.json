{
  "name": "usegrunt",
  "version": "0.7.18",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3@12.11.1"
    ]
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc && cp src/chat.html dist/chat.html && mkdir -p dist/registry dist/admin-public && cp registry/adapters.json dist/registry/adapters.json && cp site/admin/index.html site/admin/admin.css site/admin/admin.js dist/admin-public/ && cp site/grunt.svg dist/grunt.svg && cp site/favicon.svg dist/favicon.svg",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src && tsc --noEmit",
    "local": "tsx src/local/main.ts",
    "admin:collector": "tsx src/admin/collector.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@hono/node-server": "^1.19.17",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@trusty-squire/mcp": "1.1.39",
    "@trusty-squire/sdk": "0.1.0",
    "ajv": "^8.20.0",
    "chalk": "^6.0.1",
    "hono": "^4.13.8",
    "ipaddr.js": "^2.5.0",
    "jsonc-parser": "3.3.1",
    "standardwebhooks": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  },
  "bin": {
    "usegrunt": "dist/local/main.js",
    "grunt-local": "dist/local/main.js",
    "milo": "dist/local/main.js",
    "milo-local": "dist/local/main.js"
  },
  "description": "One-command setup for grunt",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bananaman614305/grunt.git"
  },
  "homepage": "https://grunt.run",
  "bugs": {
    "url": "https://github.com/bananaman614305/grunt/issues"
  }
}
